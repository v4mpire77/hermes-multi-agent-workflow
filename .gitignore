# ── Secrets — NEVER commit (see docs/06-security.md) ──
.env
*.env
!.env.example
auth.json
**/auth.json

# ── Board databases + generated data ──
*.db
*.sqlite
*.sqlite3
work/
vault/
intake/

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# kanban/tests/evidence — keep the directory, ignore the dated PNGs (regen on demand)
# (TEST_MATRIX.md is the durable record; PNGs are regenerated by scripts/test-matrix.sh)
kanban/tests/evidence/*.png

# python cache under kanban/tests
kanban/tests/__pycache__/
kanban/tests/**/__pycache__/
